{
  "name": "@learning-loop/plugin",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm build:wasm && node esbuild.config.mjs production",
    "build:wasm": "wasm-pack build ../wasm/ll-client-core --target web --out-dir pkg --release",
